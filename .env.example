# Set this to the UIDAI recipient verified by the operator before deployment.
UIDAI_RECIPIENT=help@uidai.gov.in

# Optional: set these paths to enable HTTPS for customer QR links.
# TLS_KEY_PATH=C:\\path\\to\\private-key.pem
# TLS_CERT_PATH=C:\\path\\to\\certificate.pem

# Optional: use this when the automatic LAN address is not the correct QR URL.
# PUBLIC_ORIGIN=https://your-cybercafe.example
